#!/usr/bin/env bash
set -euo pipefail

channel=
case "$#" in
    0) channel=stable ;;
    1) [[ $1 == --edge ]] && channel=edge ;;
esac
if [[ -z $channel ]]; then
    echo 'Usage: install-workspace [--edge]' >&2
    exit 2
fi
if [[ $(uname -s) != Linux || $(uname -m) != x86_64 ]]; then
    echo 'Presidio workspace currently supports Linux x86-64 only.' >&2
    exit 1
fi

repo=https://github.com/BLig-Vox/presidio
api=https://api.github.com/repos/BLig-Vox/presidio/releases
install_root=${XDG_DATA_HOME:-$HOME/.local/share}/presidio
bin_dir=$HOME/.local/bin
command_path=$bin_dir/presidio

mkdir -p -- "$install_root" "$bin_dir"
exec 9>"$install_root/install.lock"
flock 9
if [[ -e $command_path || -L $command_path ]] &&
   [[ $(readlink -- "$command_path" || true) != "$install_root/launcher" ]]; then
    echo "Not replacing an existing command at $command_path. Move it aside to install the managed workspace." >&2
    exit 1
fi

endpoint=$api/latest
[[ $channel != edge ]] || endpoint="$api?per_page=100"
selection=$(curl -fLsS --proto '=https' --proto-redir '=https' "$endpoint" | python3 -c '
import json
import re
import sys

channel = sys.argv[1]
payload = json.load(sys.stdin)
releases = payload if channel == "edge" else [payload]
candidates = []
for release in releases:
    tag = release["tag_name"]
    pattern = r"edge-([1-9][0-9]*)" if channel == "edge" else r"v[0-9]+\.[0-9]+\.[0-9]+"
    match = re.fullmatch(pattern, tag)
    if not match or release["draft"] or release["prerelease"] != (channel == "edge"):
        continue
    name = f"presidio-workspace-x86_64-unknown-linux-gnu-{tag}.tgz"
    for asset in release["assets"]:
        digest = asset.get("digest") or ""
        if asset["name"] == name and re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
            order = int(match[1]) if channel == "edge" else 0
            candidates.append((order, tag, name, digest[7:]))
            break
if not candidates:
    sys.exit(f"No verified Presidio {channel} workspace release is available.")
print(*max(candidates)[1:])
' "$channel")
read -r version asset digest <<< "$selection"
destination=$install_root/$version

staging=$(mktemp -d "$install_root/.install.XXXXXX")
bin_stage=$(mktemp -d "$bin_dir/.presidio.XXXXXX") || { rmdir -- "$staging"; exit 1; }
trap 'rm -rf -- "$staging" "$bin_stage"' EXIT
if [[ ! -d $destination ]]; then
    echo "Downloading Presidio workspace ($version)..."
    curl -fLsS --proto '=https' --proto-redir '=https' \
        --output "$staging/workspace.tgz" "$repo/releases/download/$version/$asset"
    printf '%s  %s\n' "$digest" workspace.tgz | (cd -- "$staging" && sha256sum --check --status) ||
        { echo 'Presidio workspace checksum mismatch.' >&2; exit 1; }
    mkdir -- "$staging/bundle"
    tar -xzf "$staging/workspace.tgz" -C "$staging/bundle"
    test -x "$staging/bundle/presidio"
    test -x "$staging/bundle/scripts/arch-oci"
    test -s "$staging/bundle/runtime/linux-x86_64/arch-xfce.oci.tar"
    mv -T -- "$staging/bundle" "$destination"
fi

cat > "$staging/launcher" <<'LAUNCHER'
#!/usr/bin/env bash
set -euo pipefail
root=${XDG_DATA_HOME:-$HOME/.local/share}/presidio

case ${1:-} in
    --update)
        shift
        if (( $# > 1 )) || { (( $# == 1 )) && [[ $1 != --edge ]]; }; then
            echo 'Usage: presidio --update [--edge]' >&2
            exit 2
        fi
        installer=$(curl -fsSL --proto '=https' --proto-redir '=https' https://raw.githubusercontent.com/BLig-Vox/presidio/main/scripts/install-workspace)
        exec bash -c "$installer" install-workspace "$@"
        ;;
    --edge)
        echo 'Use presidio --update --edge to install a preview.' >&2
        exit 2
        ;;
esac

if (( $# == 0 )); then
    exec "$root/current/scripts/arch-oci" --launch
fi
exec "$root/current/presidio" "$@"
LAUNCHER
chmod +x -- "$staging/launcher"

"$destination/presidio" --desktop
ln -s -- "$version" "$staging/current"
mv -Tf -- "$staging/current" "$install_root/current"
mv -Tf -- "$staging/launcher" "$install_root/launcher"
ln -s -- "$install_root/launcher" "$bin_stage/presidio"
mv -Tf -- "$bin_stage/presidio" "$command_path"
echo "Presidio $version is ready. Open Presidio from your applications menu."
if [[ $(command -v presidio || true) != "$command_path" ]]; then
    echo "For terminal commands, use $command_path or put $bin_dir first on PATH."
fi
